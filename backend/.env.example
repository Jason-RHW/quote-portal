# ── Database ────────────────────────────────────────────────
# Supabase: Settings → Database → Connection String
# Use the POOLER url (port 6543), not the direct url (port 5432)
# The pooler handles connection limits correctly for serverless
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Auth ────────────────────────────────────────────────────
# Generate: python scripts/hash_password.py yourpassword
APP_PASSWORD_HASH=$2b$12$...

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# ── CORS ────────────────────────────────────────────────────
# Local dev: leave this unset (defaults to http://localhost:5173)
# Production: set to your Vercel frontend URL
FRONTEND_URL=https://your-frontend.vercel.app
