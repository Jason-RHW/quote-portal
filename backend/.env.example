# ── Database ────────────────────────────────────────────────
# Local dev/backfill: use the SQLite file in this backend folder.
DATABASE_URL=sqlite:///./quote_portal.db

# Supabase: Settings → Database → Connection String
# Use the POOLER url (port 6543), not the direct url (port 5432)
# The pooler handles connection limits correctly for serverless
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Auth ────────────────────────────────────────────────────
# Generate: python scripts/hash_password.py yourpassword
APP_PASSWORD_HASH=$2b$12$...

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# ── CORS ────────────────────────────────────────────────────
# Local dev: leave both unset (default to localhost:5173 / :5174)
# Production: set to your two Vercel frontend URLs
FRONTEND_URL=https://your-frontend.vercel.app
SAMPLE_FORM_URL=https://your-sample-form.vercel.app

# ── Sample Portal: AI address verification ──────────────────
# Uses the OpenAI Responses API with the hosted web_search tool — no
# separate geocoding/places API. Leave unset to run with address
# verification disabled (new requests stay "unverified", no error).
OPENAI_API_KEY=sk-...

# ── Sample Portal: HubSpot sync ──────────────────────────────
# Private app access token. Backend-only; never expose this to the frontend.
# HUBSPOT_API_KEY is also supported for compatibility with the old script.
HUBSPOT_ACCESS_TOKEN=pat-...

# Lifecycle stage value used by the old Google Sheet script for "Sample Sent".
# Leave as-is unless this stage ID changes in HubSpot.
HUBSPOT_SAMPLE_SENT_STAGE_ID=3634488044

# Lifecycle stage value used by the delivery sync script for "Sample Delivered".
# Leave as-is unless this stage ID changes in HubSpot.
HUBSPOT_SAMPLE_DELIVERED_STAGE_ID=3631125214

# Lifecycle stage ID for "Sample Requested" — set right after an SDR submits
# the form, before a sample has actually shipped. No sensible default exists
# since this stage is portal-specific; look it up under HubSpot's lifecycle
# stage settings. Required for the requested-stage sync to run at all.
HUBSPOT_SAMPLE_REQUESTED_STAGE_ID=

# ── Sample Portal: SDR-form access code ────────────────────────
# Separate from APP_PASSWORD_HASH above — a leaked SDR code should never
# reach the admin console. Generate the same way as APP_PASSWORD_HASH:
#   python scripts/hash_password.py yourSdrCode
SDR_FORM_CODE_HASH=$2b$12$...

# ── SDR Performance dashboard: Aircall ingest ──────────────────
# Separate Aircall API credentials from sdr-daily-report's own —
# a different Aircall API app/token, same Aircall account.
# Settings → Integrations → API in the Aircall dashboard.
AIRCALL_API_ID=your-aircall-api-id
AIRCALL_API_TOKEN=your-aircall-api-token

# Secures the /api/cron/* endpoints. Vercel sends this automatically as
# an Authorization: Bearer header once it's set here AND in Vercel's
# project env vars — see Vercel's Cron Jobs docs.
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
CRON_SECRET=change-me-to-a-random-string
